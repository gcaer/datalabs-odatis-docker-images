# VNC session startup: add desktop shortcuts, then start XFCE.

# Dedicated config dir for the VRE desktop: the user's existing XFCE settings and
# user-dirs.dirs (e.g. from another desktop on the cluster, home shared through
# Apptainer) would otherwise override the image ones (/etc/xdg).
export XDG_CONFIG_HOME="${HOME}/.config/vre-odatis"
mkdir -p "${XDG_CONFIG_HOME}"

# Activate the notebook env for the desktop apps: its activate.d scripts set
# PROJ_DATA, GDAL_DATA, QGIS paths... (the jupyter server runs without them)
source /srv/conda/etc/profile.d/conda.sh
conda activate "${NB_PYTHON_PREFIX:-/srv/conda/envs/notebook}"

DESKTOP_DIR="$(xdg-user-dir DESKTOP 2>/dev/null || echo "${HOME}/Desktop")"
mkdir -p "${DESKTOP_DIR}"

for app in org.qgis.qgis; do
    src="/usr/share/applications/${app}.desktop"
    dst="${DESKTOP_DIR}/${app}.desktop"
    [ -f "${src}" ] || continue
    [ -f "${dst}" ] || cp "${src}" "${dst}"
    # executable = trusted launcher for xfdesktop (no gvfs metadata in the image)
    chmod +x "${dst}"
done

# dbus-launch here, after the export: xfconfd is D-Bus activated and inherits the
# environment of the bus daemon, it would otherwise read ~/.config/xfce4.
exec /usr/bin/dbus-launch --exit-with-session xfce4-session
